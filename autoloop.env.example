# Copy to <project>/tools/autoloop/autoloop.env (git-ignored) on the machine that runs the loop.
# Every setting with its default; a project's own autoloop.env.example lists only what it changes.

# Name of this loop's systemd units (<name>.service, <name>-status.service, <name>-status.timer).
# Several loops on one host each need a distinct name; default: autoloop-<repository directory>.
# AUTOLOOP_NAME=autoloop-myproject

# Telegram: create a bot with @BotFather, send it a message, read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
# One bot per loop: two loops polling getUpdates on the same token consume each other's answers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Models per run (Claude Code aliases or full ids). The planning, verification and judge runs
# must name a Fable or Opus model; the wrapper refuses to start otherwise.
PLAN_MODEL=opus
TASK_MODEL=sonnet
VERIFY_MODEL=opus
JUDGE_MODEL=opus

# Bounds per invocation
PLAN_MAX_TURNS=60
TASK_MAX_TURNS=80
VERIFY_MAX_TURNS=40
JUDGE_MAX_TURNS=40
STAGE_TIMEOUT_S=5400

# Loop bounds
MAX_ITERATIONS=200
NO_PROGRESS_LIMIT=3
# Characters of the last run's result quoted in the no-progress question and Telegram message.
RUN_REASON_CHARS=700
# Runs in a row whose broken PROGRESS.md (a lost task heading) is restored and retried before the loop stops.
PROGRESS_REPAIR_LIMIT=2

# Usage-limit handling
LIMIT_SLEEP_DEFAULT_S=1800
LIMIT_SLEEP_MAX_S=10800
LIMIT_NOTIFY_HOURS=6

# How long a blocked loop waits for the owner's answers over Telegram before exiting (seconds; default 7 days)
ANSWER_WAIT_S=604800

# Milestone pull requests: how often to check for the merge (seconds), how often to read the checks
# while they run (seconds), the remote and the base branch
MERGE_POLL_S=600
CHECK_POLL_S=120
# A red check reopens the milestone with a "Make CI green" task; after this many such tasks in one
# milestone the loop blocks with a question. The acceptance command written into that task; each
# make target that failed in the job log is appended to it.
CI_REOPEN_LIMIT=3
CI_FIX_ACCEPTANCE=tools/lint/lint.sh
# Run (bash -c, from the project root) in place of CI when GitHub refuses to start the jobs for billing;
# default: CI_FIX_ACCEPTANCE. Its time limit in seconds.
LOCAL_GATE=tools/lint/lint.sh
LOCAL_GATE_TIMEOUT_S=7200
GIT_REMOTE=origin
BASE_BRANCH=main
# Dependabot's pull requests on the base branch: the loop looks at them before every run and while it
# waits for a milestone merge. A green, mergeable one is merged with this method (squash, merge or
# rebase) and the base branch is then merged into the milestone branch; "report" only tells you about
# a green one; "ignore" leaves them all alone. A red one is never merged.
DEPENDABOT_MERGE=squash
# A red one is looked at once per head commit. "judge": a judge run (JUDGE_MODEL, prompts/dependabot.md)
# reads the failed log and the diff; flaky has the failed jobs run again once, broken or unclear is told
# to you with the judge's reason. "off": no judge run, you are told the check failed.
DEPENDABOT_TRIAGE=judge

# The project's services while the loop runs, so that you can open what it builds (a staging).
# STAGING_UP starts them or brings them up to date (bash -c, from the repository root); it runs when
# the loop starts and again after every commit, with STAGING_PORT_<NAME> set to a free port for every
# name in STAGING_SERVICES (upper case, "-" as "_"): the first free one at or above STAGING_PORT_BASE,
# kept in log/staging.ports and used again while it stays free. A command that returns has detached
# the services (docker compose up -d); one that keeps running is the service (a dev server) and is
# stopped before the next STAGING_UP and when the loop exits. Quote a command with spaces; single
# quotes keep $STAGING_PORT_<NAME> for the command. Empty: no staging.
STAGING_UP=
# STAGING_UP="docker compose -f compose.staging.yml up -d --build"
# STAGING_UP='PORT=$STAGING_PORT_WEB npm run dev'
STAGING_SERVICES=
# STAGING_SERVICES="web api"
STAGING_PORT_BASE=42000
# Run when the loop exits, and before its first STAGING_UP (bash -c, from the repository root), so that
# the services of an earlier loop are gone; empty leaves detached services running after the loop.
STAGING_DOWN=
# STAGING_DOWN="docker compose -f compose.staging.yml down"
# The host in the URLs you are told (http://<host>:<port>); default: this machine's hostname.
STAGING_HOST=
# Seconds to wait after STAGING_UP for every service to accept a connection on its port before you are
# told the URLs, with the ones that do not answer marked.
STAGING_READY_S=120

# Permission mode passed to claude -p; the allowlist and the guard hook are in .claude/settings.json
PERMISSION_MODE=acceptEdits
# AUTOLOOP_BRANCH=autoloop/M0   # default: autoloop/<MILESTONE from PROGRESS.md>
# CLAUDE_BIN=claude
